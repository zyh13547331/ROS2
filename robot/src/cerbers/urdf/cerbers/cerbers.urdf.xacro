<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cerbers">
<!-- 身体 -->
<xacro:include filename="base.urdf.xacro"/>
<!-- 传感器 -->
<xacro:include filename="sensor/imu.urdf.xacro"/>
<xacro:include filename="sensor/camera.urdf.xacro"/>
<xacro:include filename="sensor/laser.urdf.xacro"/>

<!-- 调用宏 -->

<xacro:base_xacro length="0.12" radius="0.1" />
<xacro:imu_xacro xyz="0.0 0.0 0.02" />
<xacro:camera_xacro xyz="0.10 0.0 0.075" />
<xacro:laser_xacro xyz="0.0 0.0 0.11" />
    
</robot>